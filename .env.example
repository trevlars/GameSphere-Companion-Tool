# GameSphere Companion Tool — environment overrides (optional)
#
# On Linux/macOS you usually don't need this file. Run:
#   gamesphere-import --auto-config
# or just:
#   gamesphere-import
# Paths are auto-detected when variables below are unset.

# Host: sunshine (default) or apollo
# HOST=sunshine

# --- Only set these if auto-detection picks the wrong paths ---
# steam_library_vdf_path=
# sunshine_apps_json_path=
# sunshine_grids_folder=

# Optional: community cover art (default = Steam CDN, no signup)
# steamgriddb_api_key=

# Windows-only overrides (auto-detected on Linux)
# STEAM_EXE_PATH=
# SUNSHINE_EXE_PATH=

# Windows-only: Epic, Xbox, custom games, shortcuts
# EPIC_MANIFESTS_PATH=
# CUSTOM_GAMES_JSON_PATH=
# XBOX_GAMES_FOLDERS=
# SUNSHINE_SHORTCUTS_FOLDER=
