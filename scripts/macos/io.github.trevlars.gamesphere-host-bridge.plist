<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  GameSphere Companion host daemon — LaunchAgent template.
  `main.py --host-daemon-install` writes a copy with real ProgramArguments
  into ~/Library/LaunchAgents/. KeepAlive restarts on crash; this does not
  touch Sunshine. No .app bundle is shipped.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.trevlars.gamesphere-host-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>REPLACEME/main.py</string>
    <string>--host-bridge</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPLACEME</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>3</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/tmp/gamesphere-host-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/gamesphere-host-bridge.log</string>
</dict>
</plist>
